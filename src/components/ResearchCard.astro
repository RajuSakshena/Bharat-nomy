---
interface Props {
  title: string;
  summary: string;
  date: Date;
  category: string;
  authors: string[];
  slug: string;
}

const { title, summary, date, category, authors, slug } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});

const categoryColors: Record<string, string> = {
  law: 'bg-amber-100 text-amber-800',
  economics: 'bg-blue-100 text-blue-800',
  policy: 'bg-emerald-100 text-emerald-800',
  finance: 'bg-purple-100 text-purple-800'
};

const badgeColor = categoryColors[category.toLowerCase()] || 'bg-gray-100 text-gray-800';
const linkHref = slug.startsWith('/') ? slug : `/research/${slug}`;
---

<div class="bg-white border border-stone-200 rounded-lg p-6 hover:shadow-md transition-shadow flex flex-col h-full">
  <div class="mb-4">
    <span class={`font-sans text-xs uppercase tracking-wider font-semibold px-2.5 py-1 rounded-full ${badgeColor}`}>
      {category}
    </span>
  </div>
  <a href={linkHref} class="group">
    <h3 class="text-xl font-bold text-primary-900 font-serif mb-3 group-hover:text-primary-700 transition-colors">{title}</h3>
  </a>
  <p class="text-text-secondary text-base leading-relaxed line-clamp-3 mb-6 flex-grow">{summary}</p>
  <div class="mt-auto flex justify-between items-center border-t border-stone-100 pt-4">
    <span class="font-sans text-sm text-text-muted">{authors.join(', ')}</span>
    <time datetime={date.toISOString()} class="font-sans text-sm text-text-muted">{formattedDate}</time>
  </div>
</div>
