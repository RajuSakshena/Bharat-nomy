---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/* =========================================================================
   PAGE METADATA
   ========================================================================= */
const title = 'Dashboards';
const description =
  'Interactive state-by-state profiles covering climate resilience, energy, macroeconomic health, and market activity — coming soon.';
---

<!doctype html>
<html lang="en">
<head>
  <script is:inline>
    /* Force the Dashboards page to start at the very top on a fresh
       load/refresh. Scoped to this page only (inline in dashboards.astro),
       so it has no effect on any other page's scroll behaviour. */
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }

    window.addEventListener('load', () => {
      window.scrollTo(0, 0);
    });
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Bharatnomy</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} | Bharatnomy`} />
  <meta property="og:description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* Match the Research/Datasets pages' typography direction: force
       Inter/sans-serif, overriding any font-serif/Merriweather rule that
       may come from global.css. */
    :global(body),
    :global(body *) {
      font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-bg text-text-primary font-sans" style="font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;">

  <Header />

  <main class="flex-1">
    {/* PAGE HEADING */}
    <section class="bg-white py-20 md:py-24 border-b border-stone-200">
      <div class="max-w-4xl mx-auto px-6">
        <h1 class="text-4xl md:text-5xl font-bold font-sans tracking-tight text-[#12151C] mb-4">Dashboards</h1>
        <p class="text-lg md:text-xl text-[#8A909C] leading-relaxed">India, state by state — coming soon.</p>
      </div>
    </section>

    {/* INTRO */}
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-lg text-text-primary leading-relaxed">
          Numbers rarely mean much on their own. We're building a set of interactive state profiles — one for each Indian state — covering our core focus areas: climate resilience, energy, macroeconomic health, and market activity, all in one place, built to be explored rather than just read.
        </p>
      </div>
    </section>

    {/* WHAT TO EXPECT */}
    <section class="bg-[#F5F6F8] py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-bold font-sans tracking-tight text-[#224D95] mb-6">What to expect</h2>
        <p class="text-lg text-text-primary leading-relaxed">
          Each state profile will let you move between the big picture and the specific — compare states against each other, or dig into what's happening in one. Still in the research and build phase; the first profiles will roll out as they're ready rather than all at once.
        </p>
      </div>
    </section>

    {/* CLOSING / SUBSCRIBE CTA */}
    <section class="bg-[#12151C] py-16 md:py-20">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="text-lg md:text-xl text-white/80 leading-relaxed mb-8">
          Subscribe to be notified as state profiles go live.
        </p>
        <button
          type="button"
          class="inline-block px-8 py-3 rounded-md bg-[#1F8A82] text-white font-semibold font-sans hover:bg-[#1a7871] transition-colors"
        >
          Subscribe
        </button>
      </div>
    </section>
  </main>

  <Footer />

</body>
</html>