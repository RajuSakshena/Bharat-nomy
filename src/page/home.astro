---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/* =========================================================================
   PAGE METADATA (from BaseLayout.astro defaults, as used by index.astro's
   <BaseLayout title="Home"> call — description uses the BaseLayout default)
   ========================================================================= */
const title = 'Home';
const description = 'Bharatnomy — Evidence-based public policy and economic research for India';

/* =========================================================================
   HOMEPAGE CONTENT (from src/content/pages/homepage.json)
   ========================================================================= */
const homepageData = {
  heroTitle: "Evidence-Based Research for India's Economic Future",
  heroSubtitle: "Interdisciplinary analysis spanning law, economics, public policy, and finance. Rigorous research accessible to every citizen.",
  missionStatement: "This platform exists to democratize high-rigor research, datasets, and economic insights for Indian citizens and market actors.",
  missionDetail: "We combine law, economics, policy, and finance into an interdisciplinary, evidence-based research portal. Every claim is verified. Every dataset is open. Every analysis serves the public interest."
};

/* =========================================================================
   FOCUS AREAS (static editorial copy)
   ========================================================================= */
const focusAreas = [
  {
    title: 'Climate adaptation & resilience',
    description: "how India's institutions are (and aren't) preparing for a hotter, less predictable future.",
    lens: 'Research lens — institutional readiness, climate risk, and resilience.'
  },
  {
    title: 'Energy policy & markets',
    description: 'the economics behind the transition, not just the headlines.',
    lens: 'Research lens — energy transition economics, policy design, and market signals.'
  },
  {
    title: "India's macroeconomic health",
    description: 'growth, inflation, and fiscal capacity, read plainly.',
    lens: 'Research lens — growth, inflation, fiscal capacity, and economic conditions.'
  },
  {
    title: 'Equity markets',
    description: "what's actually moving Indian capital markets, and why.",
    lens: 'Research lens — capital markets, market drivers, and investor behaviour.'
  },
  {
    title: 'Commodity markets',
    description: 'the real-economy forces behind the prices.',
    lens: 'Research lens — commodity prices, supply dynamics, and the real economy.'
  }
];
---

<!doctype html>
<html lang="en">
<head>
  <script is:inline>
    /* Force every fresh page load / refresh to start at the very top.
       - history.scrollRestoration must be set synchronously, as early as
         possible, so it takes effect before the browser tries to restore
         the previous scroll position on refresh/back-forward nav.
       - window.scrollTo(0, 0) is called immediately AND again on 'load'
         (some browsers restore scroll only after the page finishes
         loading, after this inline script already ran once).
       This only affects the initial scroll position on load; it does not
       touch the Focus Areas sticky/overlap behaviour that happens once
       the user scrolls after load. */
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);
    window.addEventListener('load', () => window.scrollTo(0, 0));
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Bharatnomy</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} | Bharatnomy`} />
  <meta property="og:description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* Direction 3 typography: force Inter/sans-serif on the Home page,
       explicitly overriding any font-serif/Merriweather rule that may
       come from global.css so headings, body text, metadata, links and
       labels all render in Inter. */
    :global(body),
    :global(body *) {
      font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    }

    /* Focus Areas — TRUE overlapping sticky card stack.
       Structure: .focus-stack (container) > .focus-card-wrapper (one per
       card, provides scroll runway) > .focus-sticky (the card itself).

       Why the previous version only pushed instead of overlapping:
       each .focus-card-wrapper was a plain block in normal flow, so
       wrapper N+1 only began in the document AFTER wrapper N's box
       (start + height) ended. That meant card N lost its sticky
       containment (and scrolled fully out of view) before card N+1's
       wrapper ever started — there was no shared scroll range in which
       both boxes were simultaneously "live", so no physical overlap
       was possible no matter what top/z-index values the cards used.

       The fix: pull every wrapper after the first one UP with a negative
       top margin (roughly the visible card height minus a small "peek"
       amount). This does not shrink the wrapper's own box (still a full
       80–100vh of scroll runway per card) — it only makes wrapper N+1's
       box START earlier in the document, while wrapper N's box still
       ends where it always did. That creates a shared/overlapping scroll
       range: while the user scrolls through it, wrapper N hasn't ended
       yet (card N is still sticky) AND wrapper N+1 has already begun
       (card N+1 has already reached its own sticky top and is sticky
       too). Card N+1 has a higher z-index, so it visually slides up and
       over card N instead of shoving it away.

       Each card still sticks at nearly the same low position just below
       the header (80px, +20px per card) — that small per-card step is
       what leaves a thin sliver of every earlier card peeking out below
       the current one as visible "stack depth".

       NOTE: no ancestor of .focus-sticky may use
       overflow:hidden/auto/scroll — that silently disables sticky. */
    .focus-stack {
      position: relative;
    }

    .focus-card-wrapper {
      position: relative;
      height: 80vh;
    }

    /* Overlap: pull every wrapper after the first up over the previous
       one. Value ≈ (mobile card height ~340px) minus a ~60px peek. */
    .focus-card-wrapper + .focus-card-wrapper {
      margin-top: -280px;
    }

    .focus-card-wrapper:last-child {
      height: 55vh;
    }

    .focus-sticky {
      position: sticky;
      top: 80px;
    }

    .focus-accent {
      display: block;
      width: 2.5rem;
      height: 4px;
      border-radius: 999px;
      background-color: #1F8A82;
      margin-bottom: 1.25rem;
    }

    @media (min-width: 768px) {
      .focus-card-wrapper {
        height: 100vh;
      }

      /* Value ≈ (desktop card height ~400px) minus a ~60px peek. */
      .focus-card-wrapper + .focus-card-wrapper {
        margin-top: -340px;
      }

      .focus-card-wrapper:last-child {
        height: 60vh;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-bg text-text-primary font-sans" style="font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;">

  <Header />

  <main class="flex-1">
    {/* HERO SECTION */}
    <section class="bg-[#12151C] text-white py-24">
      <div class="max-w-7xl mx-auto px-6 flex flex-col items-center text-center">
        <div>
          <h1 class="text-5xl font-bold font-sans tracking-tight leading-tight mb-6">{homepageData.heroTitle}</h1>
          <p class="text-xl text-white/70 mb-8 leading-relaxed">{homepageData.heroSubtitle}</p>
        </div>
      </div>
    </section>

    {/* MISSION SECTION */}
    <section class="bg-[#F5F6F8] py-24">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-sans font-semibold tracking-tight text-[#12151C] leading-relaxed mb-6">"{homepageData.missionStatement}"</h2>
        <p class="text-lg text-[#8A909C] leading-relaxed">{homepageData.missionDetail}</p>
      </div>
    </section>

    {/* FOCUS AREAS — sticky stacking cards */}
    <section class="bg-white py-24">
      <div class="max-w-4xl mx-auto px-6 text-center mb-16">
        <h2 class="text-3xl font-bold font-sans tracking-tight text-[#224D95] mb-3">Focus Areas</h2>
        <p class="text-sm md:text-base text-[#8A909C]">Where we're putting our research attention.</p>
      </div>

      <div class="max-w-full md:max-w-[820px] mx-auto px-4 md:px-6 focus-stack">
        {focusAreas.map((area, i) => (
          <div class="focus-card-wrapper">
            <div
              class="focus-sticky flex flex-col justify-between min-h-[340px] md:min-h-[400px] w-full md:max-w-[720px] mx-auto bg-white border border-stone-200 rounded-xl shadow-lg p-6 md:p-10"
              style={`top: ${80 + i * 20}px; z-index: ${(i + 1) * 10};`}
            >
              <div>
                <span class="focus-accent" aria-hidden="true"></span>
                <h3 class="text-xl md:text-2xl font-bold font-sans text-[#224D95] mb-4">
                  {area.title}
                </h3>
                <p class="text-text-secondary text-base md:text-lg leading-relaxed">
                  {area.description}
                </p>
              </div>
              <div class="border-t border-stone-100 pt-5 mt-6">
                <p class="text-sm text-[#8A909C] leading-relaxed">{area.lens}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* WHY NOW */}
    <section class="bg-[#F5F6F8] py-24">
      <div class="max-w-[800px] mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold font-sans tracking-tight text-[#224D95] mb-8">Why now</h2>
        <p class="text-lg text-text-primary leading-relaxed">
          Good research on India exists. But too much of it gets pulled toward partisan framing or locked behind paywalls most people will never cross — not because researchers set out to be partisan or exclusive, but because that's the path of least resistance. We're building Bharatnomy the other way: independent by design, and made for people outside the room where policy gets written.
        </p>
      </div>
    </section>

    {/* CLOSING CTA / SUBSCRIBE */}
    <section class="bg-white py-24 border-t border-stone-200">
      <div class="max-w-[640px] mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold font-sans tracking-tight text-[#224D95] mb-4">
          We're building our first body of work in public.
        </h2>
        <p class="text-lg text-[#8A909C] leading-relaxed mb-10">
          Get updates as our research, datasets, and dashboards go live.
        </p>
        <form class="flex flex-col sm:flex-row gap-3 justify-center items-stretch max-w-md mx-auto">
          <input
            type="email"
            name="email"
            placeholder="Enter your email"
            aria-label="Email address"
            class="flex-1 min-w-0 px-4 py-3 rounded-md border border-stone-300 text-text-primary placeholder:text-[#8A909C] focus:outline-none focus:ring-2 focus:ring-[#1F8A82]/40 focus:border-[#1F8A82]"
          />
          <button
            type="submit"
            class="px-6 py-3 rounded-md bg-[#224D95] text-white font-semibold font-sans hover:bg-[#1F8A82] transition-colors whitespace-nowrap"
          >
            Subscribe
          </button>
        </form>
      </div>
    </section>
  </main>

  <Footer />

</body>
</html>