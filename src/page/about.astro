---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/* =========================================================================
   PAGE METADATA
   ========================================================================= */
const title = 'About';
const description =
  "Bharatnomy is an independent research firm studying India's economy as a connected system.";
---

<!doctype html>
<html lang="en">
<head>
  <script is:inline>
    /* Force the About page to start at the very top on a fresh
       load/refresh. Scoped to this page only (inline in about.astro),
       so it has no effect on any other page's scroll behaviour. */
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }

    window.addEventListener('load', () => {
      window.scrollTo(0, 0);
    });
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Bharatnomy</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} | Bharatnomy`} />
  <meta property="og:description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* Match the Research/Datasets/Dashboards pages' typography direction:
       force Inter/sans-serif, overriding any font-serif/Merriweather rule
       that may come from global.css. */
    :global(body),
    :global(body *) {
      font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-bg text-text-primary font-sans" style="font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;">

  <Header />

  <main class="flex-1">
    {/* PAGE HEADING */}
    <section class="bg-white py-20 md:py-24 border-b border-stone-200">
      <div class="max-w-4xl mx-auto px-6">
        <h1 class="text-4xl md:text-5xl font-bold font-sans tracking-tight text-[#12151C] mb-4">About</h1>
      </div>
    </section>

    {/* OPENING */}
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6 space-y-6">
        <p class="text-lg text-text-primary leading-relaxed">
          Bharatnomy is an independent research firm studying India's economy as a system — where climate, energy, capital markets, and public policy are treated as connected, because they are.
        </p>
        <p class="text-lg text-text-primary leading-relaxed">
          We started Bharatnomy because most research on India's economy is built to serve one audience: other specialists. We're building ours for a wider one — investors, civil servants, journalists, and anyone who wants to understand how the country actually works, not just what happened this week.
        </p>
      </div>
    </section>

    {/* HOW WE THINK */}
    <section class="bg-[#F5F6F8] py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-bold font-sans tracking-tight text-[#224D95] mb-6">How we think</h2>
        <div class="space-y-6">
          <p class="text-lg text-text-primary leading-relaxed">
            Siloed analysis misses how India's economy actually behaves. A heatwave is a climate story, an energy story, an agriculture story, and a fiscal story, all at once — and research that only tells one of those stories tells an incomplete one. Our work is built across disciplines from the start: law, economics, policy, and finance, in the same room, on the same questions.
          </p>
          <p class="text-lg text-text-primary leading-relaxed">
            We're independent, and we intend to stay that way. That shows up in how we work, not in a mission statement — in what we choose to study, who funds it, and how plainly we're willing to write it.
          </p>
        </div>
      </div>
    </section>

    {/* THE TEAM */}
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-bold font-sans tracking-tight text-[#224D95] mb-10">The team</h2>

        <div class="space-y-8">
          <div class="border border-stone-200 rounded-lg p-6 md:p-8">
            <h3 class="text-xl font-bold font-sans text-[#12151C] mb-3">S — Partner</h3>
            <p class="text-lg text-text-primary leading-relaxed">
              S's background is in finance and wealth management, bringing a practitioner's read on capital markets and how policy decisions actually move money — not just how they're supposed to.
            </p>
          </div>

          <div class="border border-stone-200 rounded-lg p-6 md:p-8">
            <h3 class="text-xl font-bold font-sans text-[#12151C] mb-3">K — Partner</h3>
            <p class="text-lg text-text-primary leading-relaxed">
              K is a policy and social impact professional who runs his own think tank. He previously worked with the World Bank in Washington, D.C. and with the Maharashtra government, and studied public policy at the University of Chicago. His work sits at the intersection of institutional design and on-the-ground implementation.
            </p>
          </div>

          <div class="border border-stone-200 rounded-lg p-6 md:p-8">
            <h3 class="text-xl font-bold font-sans text-[#12151C] mb-3">SN — Partner &amp; CEO</h3>
            <p class="text-lg text-text-primary leading-relaxed">
              SN trained originally in the natural sciences, with a master's degree in medical nanotechnology, before moving into policy research. He studied public policy at the University of Chicago and has since focused on qualitative, field-based research — bringing a scientist's rigor to questions that don't usually get that kind of scrutiny.
            </p>
          </div>
        </div>

        <p class="text-base text-[#8A909C] leading-relaxed mt-10">
          Bharatnomy is a young firm. We think that's worth saying plainly, not hiding.
        </p>
      </div>
    </section>
  </main>

  <Footer />

</body>
</html>