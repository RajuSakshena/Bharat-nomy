---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/* =========================================================================
   PAGE METADATA
   ========================================================================= */
const title = 'Datasets';
const description =
  "Original survey data, cleaned government data, and proprietary indices for research on India's economy — coming soon, built in the open.";

/* =========================================================================
   STATIC EDITORIAL CONTENT
   ========================================================================= */
const dataTypes = [
  {
    title: 'Original survey data',
    description: "collected directly, for questions where existing data doesn't go deep enough."
  },
  {
    title: 'Cleaned, compiled government data',
    description:
      "the numbers that already exist, but scattered across sources and formats that make them hard to use. We'll do the unglamorous work of making them usable."
  },
  {
    title: 'Proprietary indices',
    description: 'composite measures we build ourselves, when no existing metric captures what we think matters.'
  }
];
---

<!doctype html>
<html lang="en">
<head>
  <script is:inline>
    /* Force the Datasets page to start at the very top on a fresh
       load/refresh. Scoped to this page only (inline in datasets.astro),
       so it has no effect on any other page's scroll behaviour. */
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }

    window.addEventListener('load', () => {
      window.scrollTo(0, 0);
    });
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Bharatnomy</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} | Bharatnomy`} />
  <meta property="og:description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* Match the Home/Research pages' typography direction: force
       Inter/sans-serif, overriding any font-serif/Merriweather rule that
       may come from global.css. */
    :global(body),
    :global(body *) {
      font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-bg text-text-primary font-sans" style="font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;">

  <Header />

  <main class="flex-1">
    {/* PAGE HEADING */}
    <section class="bg-white py-20 md:py-24 border-b border-stone-200">
      <div class="max-w-4xl mx-auto px-6">
        <h1 class="text-4xl md:text-5xl font-bold font-sans tracking-tight text-[#12151C] mb-4">Datasets</h1>
        <p class="text-lg md:text-xl text-[#8A909C] leading-relaxed">Data you can actually use — coming soon, built in the open.</p>
      </div>
    </section>

    {/* INTRO */}
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-lg text-text-primary leading-relaxed">
          Good research needs good data, and good data is often the hardest part to get right in India — scattered across sources, inconsistently defined, or simply hard to find. Part of Bharatnomy's work is fixing that, not just for ourselves, but for anyone who needs it.
        </p>
      </div>
    </section>

    {/* WHAT WE'RE BUILDING */}
    <section class="bg-[#F5F6F8] py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-bold font-sans tracking-tight text-[#224D95] mb-10">What we're building</h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {dataTypes.map((type) => (
            <div class="bg-white border border-stone-200 rounded-lg p-6">
              <h3 class="text-lg font-bold font-sans text-[#224D95] mb-3">{type.title}</h3>
              <p class="text-text-secondary text-base leading-relaxed">{type.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* CLOSING */}
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-lg text-text-primary leading-relaxed">
          This page will fill in as datasets go live. If there's a specific dataset you wish existed, tell us — it's genuinely useful input for what we build first.
        </p>
      </div>
    </section>
  </main>

  <Footer />

</body>
</html>