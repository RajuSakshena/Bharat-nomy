---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/* =========================================================================
   PAGE METADATA
   ========================================================================= */
const title = 'Research';
const description =
  'Independent research on India’s economy, policy, markets, and connected systems.';

/* =========================================================================
   STATIC EDITORIAL CONTENT
   ========================================================================= */
const outputForms = [
  {
    title: 'Working papers',
    description: 'The deep, technical version, for readers who want the full method.'
  },
  {
    title: 'Reports',
    description: 'Longer-form, structured analysis meant to stand on its own.'
  },
  {
    title: 'Policy briefs',
    description: "Short, direct, built for people who need the conclusion and the 'so what' fast."
  }
];

const activeProject = {
  title: 'Tracking Heat Action Plans across Maharashtra',
  description:
    "India's districts are increasingly required to have Heat Action Plans — but having a plan and implementing one are different things. We're building a district-by-district picture of what's on paper versus what's actually happening on the ground. Still in the research phase — more soon."
};
---

<!doctype html>
<html lang="en">
<head>
  <script is:inline>
    /* Force the Research page to start at the very top on a fresh
       load/refresh. Scoped to this page only (inline in research.astro),
       so it has no effect on any other page's scroll behaviour. */
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }

    window.addEventListener('load', () => {
      window.scrollTo(0, 0);
    });
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Bharatnomy</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} | Bharatnomy`} />
  <meta property="og:description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* Match the Home page's typography direction: force Inter/sans-serif,
       overriding any font-serif/Merriweather rule that may come from
       global.css, so headings, body text, and labels all render in Inter. */
    :global(body),
    :global(body *) {
      font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-bg text-text-primary font-sans" style="font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;">

  <Header />

  <main class="flex-1">
    {/* PAGE HEADING */}
    <section class="bg-white py-20 md:py-24 border-b border-stone-200">
      <div class="max-w-4xl mx-auto px-6">
        <h1 class="text-4xl md:text-5xl font-bold font-sans tracking-tight text-[#12151C] mb-4">Research</h1>
        <p class="text-lg md:text-xl text-[#8A909C] leading-relaxed">We're early. Here's how we work, and what's coming.</p>
      </div>
    </section>

    {/* INTRO */}
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-lg text-text-primary leading-relaxed">
          Bharatnomy doesn't have a publication history yet — we're a new firm, and we'd rather tell you that directly than pretend otherwise. What we do have is a method, a set of questions we think are underexamined, and a first project already underway.
        </p>
      </div>
    </section>

    {/* OUR APPROACH */}
    <section class="bg-[#F5F6F8] py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-bold font-sans tracking-tight text-[#224D95] mb-6">Our approach</h2>
        <p class="text-lg text-text-primary leading-relaxed mb-10">
          Every piece of research we publish will sit in one (or more) of five areas: climate adaptation and resilience, energy policy and markets, India's macroeconomic health, equity markets, and commodity markets. We treat these as connected, not separate — a paper on energy policy will often touch fiscal capacity; a paper on climate resilience will often touch capital markets.
        </p>

        <p class="text-base font-semibold font-sans text-[#12151C] mb-6">Our output will take three forms:</p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {outputForms.map((form) => (
            <div class="bg-white border border-stone-200 rounded-lg p-6">
              <h3 class="text-lg font-bold font-sans text-[#224D95] mb-3">{form.title}</h3>
              <p class="text-text-secondary text-base leading-relaxed">{form.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* CURRENTLY IN PROGRESS */}
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-bold font-sans tracking-tight text-[#224D95] mb-8">Currently in progress</h2>

        <div class="bg-[#F5F6F8] border-l-4 border-[#1F8A82] rounded-r-lg p-6 md:p-8">
          <h3 class="text-xl font-bold font-sans text-[#12151C] mb-4">{activeProject.title}</h3>
          <p class="text-text-secondary text-base md:text-lg leading-relaxed">{activeProject.description}</p>
        </div>
      </div>
    </section>

    {/* CLOSING / SUBSCRIBE CTA */}
    <section class="bg-[#12151C] py-16 md:py-20">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="text-lg md:text-xl text-white/80 leading-relaxed mb-8">
          Want to know when our first paper is out? We'll only email when there's something real to share.
        </p>
        <button
          type="button"
          class="inline-block px-8 py-3 rounded-md bg-[#1F8A82] text-white font-semibold font-sans hover:bg-[#1a7871] transition-colors"
        >
          Subscribe
        </button>
      </div>
    </section>
  </main>

  <Footer />

</body>
</html>