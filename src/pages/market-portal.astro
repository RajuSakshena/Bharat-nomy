---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ResearchCard from '../components/ResearchCard.astro';
import DatasetCard from '../components/DatasetCard.astro';
import Home from '../components/dashboard/Home.tsx';

const allResearch = await getCollection('research', (entry) => {
  return entry.data.status === 'published' && ['economics', 'finance'].includes(entry.data.category.toLowerCase());
});
const sortedResearch = allResearch.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allDatasets = await getCollection('datasets');
const financeDatasets = allDatasets.filter(ds => 
  ['financial inclusion', 'macroeconomics'].includes(ds.data.category.toLowerCase())
);
---

<BaseLayout title="Market Portal" description="Analytical research for impact investors and financial analysts.">
  <div class="bg-brown-800 text-white py-16">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-bold font-serif mb-4">Market Portal</h1>
      <p class="text-xl text-primary-200 max-w-2xl mx-auto">
        Evidence-driven insights into regulatory trends and economic indicators for impact investors, fund managers, and analysts.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 py-16">
    <h2 class="text-3xl font-bold text-primary-900 mb-8">Mutual Fund Analytics Dashboard</h2>
    <Home client:load />
  </div>

  <div class="max-w-7xl mx-auto px-6 py-16">
    <h2 class="text-3xl font-bold text-primary-900 mb-8">Economic & Financial Analysis</h2>
    {sortedResearch.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {sortedResearch.map(entry => (
          <ResearchCard 
            title={entry.data.title}
            summary={entry.data.summary}
            date={entry.data.date}
            category={entry.data.category}
            authors={entry.data.authors}
            slug={`/research/${entry.id}`}
          />
        ))}
      </div>
    ) : (
      <p class="text-text-muted mb-16">No research papers available in this category.</p>
    )}

    <h2 class="text-3xl font-bold text-primary-900 mb-8">Relevant Datasets</h2>
    {financeDatasets.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {financeDatasets.map(entry => (
          <DatasetCard 
            title={entry.data.title}
            description={entry.data.description}
            format={entry.data.format}
            source={entry.data.source}
            file={entry.data.file}
            date={entry.data.date}
            slug={`/datasets/${entry.id}`}
          />
        ))}
      </div>
    ) : (
      <p class="text-text-muted">No datasets available in this category.</p>
    )}
  </div>
</BaseLayout>