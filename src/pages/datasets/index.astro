---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import DatasetCard from '../../components/DatasetCard.astro';

const allDatasets = await getCollection('datasets');
const sortedDatasets = allDatasets.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Datasets" description="Open-access datasets for economic and policy research.">
  <div class="max-w-7xl mx-auto px-6 py-12">
    <header class="mb-12">
      <h1 class="text-4xl font-bold font-serif text-primary-900 mb-4">Open Datasets</h1>
      <p class="text-xl text-text-secondary max-w-3xl">Verified, publicly accessible datasets used in our research, open for public use and analysis.</p>
    </header>

    {sortedDatasets.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedDatasets.map(entry => (
          <DatasetCard 
            title={entry.data.title}
            description={entry.data.description}
            format={entry.data.format}
            source={entry.data.source}
            file={entry.data.file}
            date={entry.data.date}
            slug={`/datasets/${entry.id}`}
          />
        ))}
      </div>
    ) : (
      <div class="py-12 text-center text-text-muted">
        <p class="text-lg">No datasets found.</p>
      </div>
    )}
  </div>
</BaseLayout>
